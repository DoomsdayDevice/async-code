FROM node:22-alpine

# Install system dependencies
RUN apk add --no-cache \
    bash \
    git \
    curl \
    openssh-client \
    python3 \
    py3-pip \
    coreutils

# Install Codex CLI globally
# Requires Node.js 22+ according to their documentation
RUN npm install -g @openai/codex

# Set non-interactive defaults to avoid TTY/cursor errors
ENV CI=true \
    NO_COLOR=1 \
    FORCE_COLOR=0 \
    OPENAI_NONINTERACTIVE=1 \
    CODEX_QUIET_MODE=1 \
    NODE_NO_READLINE=1 \
    TERM=dumb

# Create workspace directory
WORKDIR /workspace

# Configure git (default values, will be overridden)
RUN git config --global user.email "codex-automation@automation.com" && \
    git config --global user.name "Codex Code Automation" && \
    git config --global init.defaultBranch main

# Set up environment
ENV NODE_ENV=production

# Default command
CMD ["bash"] 